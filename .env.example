# ============================================================
# AI-AUGMENTED OBSERVABILITY SYSTEM FOR ISP
# Environment Variables — Copy this file to .env and fill in
# ============================================================

# ── General ──────────────────────────────────────────────────
PROJECT_NAME=AI-Augmented-ISP-Observability
ENVIRONMENT=development
HOST_IP=127.0.0.1

# ── Network Simulator ────────────────────────────────────────
SIMULATOR_PORT=8001
SIMULATOR_INTERVAL=5
SIMULATOR_DEFAULT_SCENARIO=normal

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-password

# ── FastAPI (ML + API service) ───────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML Service ───────────────────────────────────────────────
ML_MODEL_DIR=/app/models
ANOMALY_CONTAMINATION=0.1
ANOMALY_RANDOM_STATE=42
QOE_RANDOM_STATE=42

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_GRAFANA_URL=http://localhost:3000
